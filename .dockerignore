# Keep README.md: uv_build reads it when the entrypoint installs the project at
# container startup and when the image is used without the bind mount.
# Keep .gitignore: cspell uses it through useGitignore.

# Example data: in development, these are provided via bind mount.
data/

# Version control metadata
.git

# Editor and operating system files
.vscode
.idea
.DS_Store
Thumbs.db

# Python environments and caches
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.rumdl_cache/
.mypy_cache/
.pyrefly_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# JavaScript dependencies and caches
node_modules/
.bun/

# Marimo session state and generated artifacts
notebooks/__marimo__/
notebooks/images/

# Local secrets and environment overrides
.env
.env.*
*.env

# Generated documents
*.pdf

# Docker files are not needed inside the image
Dockerfile
.dockerignore
compose.yaml
