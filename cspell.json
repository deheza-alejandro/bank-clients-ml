// cSpell Settings
{
    // Version of the setting file.  Always 0.2
    "version": "0.2",
    "language": "en,es",
    "import": [
        "@cspell/dict-es-es/cspell-ext.json"
    ],
    // words - list of words to be always considered correct
    "words": [
        "bivariado",
        "bivariate",
        "boxstyle",
        "correlacionadas",
        "cuantiles",
        "ddof",
        "decil",
        "dimensionalidad",
        "edgecolor",
        "facecolor",
        "figsize",
        "fonttype",
        "fontweight",
        "github",
        "graficar",
        "gridspec",
        "hashsalt",
        "hiperparámetros",
        "importances",
        "labelsize",
        "lefthook",
        "LGBM",
        "lightgray",
        "linestyle",
        "oversampled",
        "pydantic",
        "pyproject",
        "pyupgrade",
        "qcut",
        "ruff",
        "rumdl",
        "setext",
        "svgo",
        "triu",
        "twinx",
        "unpivot",
        "verticalalignment",
        "xlabel",
        "xlim",
        "xticklabels",
        "xticks",
        "xycoords",
        "ylabel",
        "ylim"
    ],
    // flagWords - list of words to be always considered incorrect
    // This is useful for offensive words and common spelling errors.
    // For example "hte" should be "the"
    "flagWords": [
        "hte"
    ],
    "dictionaries": [
        "python",
        "python-common",
        "typescript",
        "node",
        "softwareTerms",
        "data-science",
        "data-science-models",
        "data-science-tools"
    ],
    "ignorePaths": [
        "notebooks/images/**",
        ".vscode/**",
        "cspell.json"
    ],
    "files": [
        "src/**",
        "tests/**",
        "notebooks/*.py",
        "**/*.md",
        "lefthook.yml",
        ".lefthook/**",
        "pyproject.toml"
    ],
    "useGitignore": true
}
