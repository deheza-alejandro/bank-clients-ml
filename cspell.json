// cSpell Settings
{
    // Version of the setting file.  Always 0.2
    "version": "0.2",
    "language": "en,es",
    "import": [
        "@cspell/dict-es-es/cspell-ext.json"
    ],
    "dictionaries": [
        "python",
        "python-common",
        "typescript",
        "node",
        "softwareTerms",
        "data-science",
        "data-science-models",
        "data-science-tools"
    ],
    "useGitignore": true,
    "ignorePaths": [
        "data/**",
        "**/*.svg",
        ".vscode/**",
        "cspell.json",
        "**/LICENSE"
    ],
    "files": [
        "src/**",
        "tests/**",
        "scripts/**",
        "**/*.py",
        "**/*.md",
        "**/*.yml",
        "**/*.yaml",
        "**/*.toml"
    ],
    // words - list of words to be always considered correct
    "words": [
        "addopts",
        "allclose",
        "autouse",
        "axison",
        "binner",
        "Binner",
        "binners",
        "bivariada",
        "bivariado",
        "bivariados",
        "bivariate",
        "boxstyle",
        "bunx",
        "cardinalidad",
        "configurables",
        "correlacionada",
        "correlacionadas",
        "correlacionado",
        "correlacionados",
        "cuantiles",
        "ddof",
        "decil",
        "dejavu",
        "delenv",
        "desbalanceada",
        "desbalanceadas",
        "desbalanceado",
        "dimensionalidad",
        "dotenv",
        "edgecolor",
        "equiespaciados",
        "especificador",
        "facecolor",
        "fignum",
        "fignums",
        "figsize",
        "fonttype",
        "fontweight",
        "github",
        "graficar",
        "gridspec",
        "hashsalt",
        "healthcheck",
        "hiperparámetros",
        "htmlcov",
        "importances",
        "instanciación",
        "labelsize",
        "lefthook",
        "lgbm",
        "LGBM",
        "libgomp",
        "lightgray",
        "linalg",
        "linestyle",
        "lockfiles",
        "montos",
